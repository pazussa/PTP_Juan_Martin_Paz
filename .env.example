# Aplicación bajo prueba
BASE_URL=https://www.bon-bonite.com

# Desarrollo local: navegador visible. Usa HEADLESS=1 en CI o si lo necesitas.
HEADLESS=0
SLOWMO=0

# Video integrado de Playwright: off | on | retain-on-failure | on-first-retry
VIDEO=on

# Las pruebas que crean/modifican datos están desactivadas por seguridad.
# `npm run test:account` habilita únicamente el alta y la modificación.
RUN_MUTATING_TESTS=0

# La compra registra una orden real pendiente de pago en el sitio objetivo.
RUN_PURCHASE_TESTS=0

# Dominio reservado para las cuentas técnicas generadas por la suite.
TEST_EMAIL_DOMAIN=example.com

# Radicado reservado y confirmado como inexistente para la consulta segura de E02.
PQRS_UNKNOWN_TRACKING_NUMBER=999999999999999

# Opcionales para scripts/codegen.js; nunca pongas credenciales en Git.
LOGIN_DOCUMENT=
LOGIN_PASSWORD=
